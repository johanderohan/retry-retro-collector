# Puerto del backend Express (dev). En Docker se fija a 3001.
PORT=3001

# Caché Redis (opcional). Si no se define, la caché queda desactivada.
# En Docker: redis://redis:6379
# REDIS_URL=redis://localhost:6379

# Carpeta de datos (retry.db + covers/ + logos/).
# Por defecto resuelve a <repo-root>/data. En Docker se fija a /app/data.
# DATA_DIR=../data
